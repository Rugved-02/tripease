            "projectName": "tripease",
            "args": "",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "java",
            "name": "Spring Boot-EurekaServerApplication<eurekaServer>",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "com.example.eurekaServer.EurekaServerApplication",
            "projectName": "eurekaServer",
            "args": "",
            "envFile": "${workspaceFolder}/.env"
        }
